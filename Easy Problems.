        for(int i=0;i<n;i++){
            st[i] = sc.nextInt();
        }
        for(int i=0;i<m;i++){
            Cookie[i] = sc.nextInt();
        }
        Solution sol = new Solution();
        int r = sol.findMaximumCookieStudents(st , Cookie);
    }
}
