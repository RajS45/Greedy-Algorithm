1.Shortest Job First
class Solution {
    public long solve(int[] bt) {
        Arrays.sort(bt);
        long waitTime = 0;
        long totalTime = 0;
        int n=bt.length;
        for(int i=0;i<n;i++){
            waitTime += totalTime;
            totalTime += bt[i];
        }
        return waitTime / n;
    }
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int []arr = new int[n];
        for(int i=0;i<n;i++){
            arr[i] = sc.nextInt();
        }
        Solution sol = new Solution();
        long res = sol.solve(arr);
    }
}
